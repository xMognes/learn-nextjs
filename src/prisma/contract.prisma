// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

enum Role {
  USER
  ADMIN
}

model User {
  id        Int         @id @default(autoincrement())
  email     String      @unique
  password  String
  role      Role        @default(USER)
  createdAt DateTime    @default(now())
  updatedAt DateTime?
}
